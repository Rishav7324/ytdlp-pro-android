<resources>
    <style name="Theme.YtDlp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Single system splash (replaces the old Compose splash screen):
         dark backdrop + Zyvro launcher icon, then straight to content. -->
    <style name="Theme.Zyvro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/zyvro_launcher</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.YtDlp</item>
    </style>
</resources>
